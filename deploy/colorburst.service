# /etc/systemd/system/colorburst.service
# sudo systemctl daemon-reload && sudo systemctl enable --now colorburst
[Unit]
Description=ColorBurst Flask webapp
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/colorburst
Environment="PATH=/var/www/colorburst/venv/bin"
ExecStart=/var/www/colorburst/venv/bin/gunicorn -c deploy/gunicorn.conf.py app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
